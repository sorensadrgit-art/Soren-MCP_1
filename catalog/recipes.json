          "actor": "agent-client-with-human-review",
          "permission": "isolated-vm",
          "requiresHumanApproval": true,
          "verification": "Asset license recorded; Blender Lab used only in an isolated VM; Spline edits confirmed by a human.",
          "outputs": [
            "source asset",
            "license note"
          ]
        },
        {
          "id": "optimize",
          "title": "Optimize and validate GLB assets",
          "capability": "asset-optimization",
          "skills": [
            "gltf-asset-pipeline"
          ],
          "integrations": [
            "gltf-transform-cli"
          ],
          "knowledgeIds": [
            "gltf-transform",
            "gltf-validator",
            "meshoptimizer",
            "ktx2-basis"
