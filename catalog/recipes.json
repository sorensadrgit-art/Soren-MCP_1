      },
      "id": "cinematic-portfolio",
      "title": "Cinematic interactive 3D portfolio",
      "profile": "immersive-web",
      "summary": "Nine-step workflow from dependency audit to draft pull request for a React Three Fiber portfolio with PBR assets, GSAP choreography and browser-verified performance.",
      "steps": [
        {
          "id": "architecture",
          "title": "Inspect architecture, dependencies and installed versions",
          "capability": "repo-analysis",
          "skills": [
            "agent-capability-navigation"
          ],
          "integrations": [
            "serena"
          ],
          "knowledgeIds": [
            "r3f-v9",
            "nextjs-16",
            "react-19"
          ],
          "actor": "agent-client",
          "permission": "read",
          "requiresHumanApproval": false,
          "verification": "Lockfile versions for react, three, fiber, drei and gsap recorded; incompatible pairs flagged.",
          "outputs": [
            "dependency report",
            "version matrix"
          ]
        },
        {
          "id": "docs",
          "title": "Retrieve version-matched documentation",
          "capability": "docs-retrieval",
          "skills": [
            "react-three-fiber"
          ],
          "integrations": [
            "context7"
          ],
          "knowledgeIds": [
            "r3f-v9",
            "drei-10",
            "gsap-react",
            "threejs-manual"
          ],
          "actor": "agent-client",
          "permission": "read",
          "requiresHumanApproval": false,
          "verification": "Every API used is cited from docs matching the installed major version.",
          "outputs": [
            "cited doc list"
          ]
        },
        {
          "id": "assets",
          "title": "Author or source 3D assets in Blender or Spline",
          "capability": "asset-authoring",
          "skills": [
            "blender-to-r3f",
            "spline-to-web"
          ],
          "integrations": [
            "blender-lab",
            "spline"
          ],
          "knowledgeIds": [
            "blender-gltf-io",
            "spline-mcp",
            "blender-lab-mcp"
