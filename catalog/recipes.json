          "permission": "local-process",
          "requiresHumanApproval": false,
          "verification": "glTF-Validator reports zero errors; before/after size and draw-call counts recorded.",
          "outputs": [
            "optimized GLB",
            "validator report",
            "size table"
          ]
        },
        {
          "id": "scene",
          "title": "Build the R3F scene, PBR materials and lighting",
          "capability": "3d-rendering",
          "skills": [
            "react-three-fiber",
            "shader-material-lab",
            "threejs-production"
          ],
          "integrations": [],
          "knowledgeIds": [
            "r3f-v9",
            "drei-10",
            "threejs-color-management"
          ],
          "actor": "agent-client",
          "permission": "local-edit",
          "requiresHumanApproval": false,
          "verification": "Scene renders without console errors; color spaces and tone mapping set deliberately; resources disposed on unmount.",
          "outputs": [
            "scene components"
          ]
        },
        {
          "id": "motion",
          "title": "Choreograph GSAP ScrollTrigger motion with reduced-motion variants",
          "capability": "motion-choreography",
          "skills": [
            "gsap-motion",
            "motion-systems",
            "accessibility"
          ],
          "integrations": [],
          "knowledgeIds": [
            "gsap-scrolltrigger",
            "gsap-react",
            "reduced-motion"
          ],
          "actor": "agent-client",
          "permission": "local-edit",
          "requiresHumanApproval": false,
          "verification": "Timelines revert on unmount; prefers-reduced-motion path verified; keyboard path to every control.",
          "outputs": [
            "motion timeline",
            "reduced-motion variant"
          ]
        },
        {
          "id": "browser",
          "title": "Verify in a real browser: screenshots, interactions, console and accessibility",
          "capability": "browser-verification",
          "skills": [
            "playwright-browser-qa",
            "graphics-performance-qa"
          ],
          "integrations": [
            "playwright",
            "chrome-devtools"
          ],
          "knowledgeIds": [
            "playwright-mcp",
            "chrome-devtools-mcp",
            "wcag-22"
          ],
          "actor": "agent-client",
          "permission": "browser",
          "requiresHumanApproval": false,
          "verification": "Screenshots at 1440, 768 and 390 px; zero console errors; WebGL fallback and keyboard checks pass.",
          "outputs": [
            "screenshots",
            "console log",
            "a11y report"
          ]
        },
        {
          "id": "performance",
          "title": "Measure performance budgets and fix regressions",
          "capability": "performance-budget",
          "skills": [
            "graphics-performance-qa"
          ],
          "integrations": [
            "chrome-devtools"
          ],
          "knowledgeIds": [
            "r3f-performance",
            "threejs-disposal",
            "webgl-best-practices"
          ],
          "actor": "agent-client",
          "permission": "browser",
          "requiresHumanApproval": false,
          "verification": "FPS, draw calls, triangles, GPU memory and load timing measured and labeled GPU or SwiftShader.",
          "outputs": [
            "metrics table",
            "trace"
          ]
        },
        {
          "id": "pull-request",
          "title": "Open a draft pull request with evidence; preview deploy only after approval",
          "capability": "delivery",
          "skills": [
            "agentic-coding",
            "soren-universal-deployment"
          ],
          "integrations": [
            "github",
            "vercel"
          ],
          "knowledgeIds": [
            "github-mcp",
            "vercel-mcp"
          ],
          "actor": "agent-client-with-human-review",
          "permission": "repo-write",
          "requiresHumanApproval": true,
          "verification": "Draft PR lists tests, metrics and rollback; no merge or production deploy without explicit approval.",
          "outputs": [
            "draft pull request",
            "rollback note"
          ]
        }
      ],
      "verificationPlan": [
        "Typecheck and unit tests pass.",
        "glTF-Validator: zero errors on shipped assets.",
        "Playwright screenshots at 1440/768/390 px with zero console errors.",
        "Reduced-motion and keyboard navigation verified.",
        "WebGL-unavailable fallback renders a static poster.",
        "Performance metrics recorded with renderer label."
      ],
      "fallbacks": [
        "No Blender: use licensed GLB assets or procedural geometry.",
        "No Spline account: skip Spline and use R3F primitives.",
        "No WebGPU: WebGL2 renderer; no WebGL: static poster.",
        "No Chrome DevTools MCP: Playwright plus in-page renderer.info sampling."
      ]
    },
