{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soren-shared-mcp-skills.vercel.app/schemas/profile.schema.json",
  "title": "SOREN capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "triggers",
    "capabilities",
    "primarySkill",
    "complementarySkills",
    "requiredIntegrations",
    "optionalIntegrations",
    "knowledgeIds",
    "recipeId",
    "prerequisites",
    "permissionBoundaries",
    "priority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "triggers": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 50
      },
      "minItems": 3
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "minItems": 1
    },
    "primarySkill": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "complementarySkills": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "requiredIntegrations": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "optionalIntegrations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "knowledgeIds": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
      }
    },
    "recipeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "permissionBoundaries": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
