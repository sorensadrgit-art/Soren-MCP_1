# Public bundled mode works without credentials. Keep these values server-only.
# Optional TypeSafe Jev advisor: disabled until funded key and quota protection.
TYPESAFE_JEV_ENABLED=false
TYPESAFE_API_KEY=
SOREN_CAPABILITY_MODE=public_only
SOREN_ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SOREN_GATEWAY_DB_KEY=
SOREN_WORKSPACE_ID=
SOREN_AUTH_AUDIENCE=
SOREN_AUTH_RESOURCE=
SOREN_AUTH_CLIENT_ID=
SOREN_MANAGEMENT_CLIENT_ID=
SOREN_ADMIN_ORIGIN=
SOREN_OAUTH_AUTHORIZATION_URL=
SOREN_OAUTH_TOKEN_URL=
SOREN_SESSION_SECRET=
SOREN_REVIEW_POLICY_SHA256=
SOREN_RATE_KEY=
CRON_SECRET=
# Release and watcher activation require their own owner-reviewed configuration.
SOREN_RELEASE_PROJECT_ID=prj_mJgbERJNKW1V96leE2yWOzsqxkpo
SOREN_RELEASE_TEAM_ID=team_4EjLBPTV0cEpjMytwNJlggaW
SOREN_RELEASE_ENVIRONMENT=production
SOREN_RELEASE_TRUST_JSON=
SOREN_RELEASE_RUNNER_CLIENT_ID=
SOREN_RELEASE_OBSERVER_CLIENT_ID=
SOREN_WATCH_GATEWAY_URL=
SOREN_WATCHER_ACCESS_TOKEN=
SOREN_WATCHER_DELIVERY_ENABLED=false
SOREN_WATCHER_CADENCE_SECONDS=900
SOREN_WATCHER_CLIENT_ID=
SOREN_GATEWAY_FAILURE_DOMAIN=
SOREN_WATCHER_FAILURE_DOMAIN=

# Optional TypeSafe advisor: all flags off by default; never put a real key in this file.
# Jev routing also needs route_task(decision_engine="jev") and the existing shared quota store.
TYPESAFE_JEV_ENABLED=false
# Additional advisory MCP tools require BOTH SOREN_V3_TOOLS=1 and this opt-in.
SOREN_TYPESAFE_TOOLS=0
TYPESAFE_API_KEY=

# Maintenance worker only; these names are consumed by the actual probe handlers.
SOREN_GATEWAY_ORIGIN=
SOREN_AUTH_PROBE_TOKEN=
SOREN_UPDATE_PROJECT_ID=
SOREN_UPDATE_ENVIRONMENT=

# Trusted release runner only. Server ingress uses SOREN_RELEASE_TRUST_JSON above;
# the CLI instead reads an owner-provisioned file. Neither is candidate-supplied trust.
SOREN_RELEASE_TRUST_FILE=
SOREN_PRODUCTION_DOMAINS=
SOREN_VERCEL_CLI_PATH=
SOREN_VERCEL_CLI_SHA256=
VERCEL_TOKEN=

# Interactive management / evidence submission only; never public gateway secrets.
SOREN_MANAGEMENT_ACCESS_TOKEN=
SOREN_EVIDENCE_ACCESS_TOKEN=
